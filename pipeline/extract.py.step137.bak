"""
Unified GCC bank financial extraction engine.

Initial implementation:
    SNB / NCB 2010

All monetary values are expressed in
local currency millions.

Existing financial datasets are never modified.
"""

import csv
from pathlib import Path

import pdfplumber

from pipeline.financial_parser import (
    extract_financial_value,
    read_pdf_page,
)


ROOT = Path(__file__).resolve().parents[1]

SCHEMA_PATH = ROOT / "output/SNB_raw_financial_data.csv"

SNB_2010_PDF = (
    ROOT / "pdfs/SNB/NCB_2010_Annual_Report.pdf"
)



SNB_REPORT_CONFIG = {
    2010: {
        "pdf": ROOT / "pdfs/SNB/NCB_2010_Annual_Report.pdf",
        "balance_page": 36,
        "income_page": 37,
        "loans_page": 55,
        "impairment_page": 56,
        "npl_confirmation_page": 83,
        "capital_page": 86,
        "printed_pages": "34-35,53-54,81,84",
    },
    2011: {
        "pdf": ROOT / "pdfs/SNB/NCB_2011_Annual_Report.pdf",
        "balance_page": 36,
        "income_page": 37,
        "loans_page": 57,
        "impairment_page": 58,
        "npl_confirmation_page": 84,
        "capital_page": 87,
        "printed_pages": "34-35,55-56,82,85",
    },

    2012: {
        "pdf": ROOT / "pdfs/SNB/NCB_2012_Annual_Report.pdf",
        "balance_page": 35,
        "income_page": 36,
        "loans_page": 56,
        "impairment_page": 57,
        "npl_confirmation_page": 58,
        "capital_page": 83,
        "rwa_page": 84,
        "printed_pages": "32-33,53-55,80-81",
    },
    2013: {
        "pdf": ROOT / "pdfs/SNB/NCB_2013_Prospectus_Financial_Statements.pdf",
        "balance_page": 330,
        "income_page": 331,
        "loans_page": 360,
        "impairment_page": 361,
        "npl_confirmation_page": 362,
        "capital_page": 402,
        "rwa_page": 402,
        "printed_pages": "299-300,329-331,371",
    },
}


def get_snb_config(year):
    """Return the verified source configuration for an SNB year."""
    if year not in SNB_REPORT_CONFIG:
        raise ValueError(f"Unsupported SNB reporting year: {year}")

    config = SNB_REPORT_CONFIG[year]

    if not config["pdf"].is_file():
        raise FileNotFoundError(config["pdf"])

    return config


def load_schema():
    with SCHEMA_PATH.open(
        encoding="utf-8-sig",
        newline="",
    ) as f:
        columns = next(csv.reader(f))

    if len(columns) != 58:
        raise ValueError(
            f"Expected 58 columns, found {len(columns)}"
        )

    if len(set(columns)) != 58:
        raise ValueError("Duplicate schema columns detected")

    return columns


def extract_snb_2010(year=2010):
    config = get_snb_config(year)
    columns = load_schema()

    record = dict.fromkeys(columns, "")

    with pdfplumber.open(config["pdf"]) as pdf:
        balance = read_pdf_page(pdf, config["balance_page"])
        income = read_pdf_page(pdf, config["income_page"])

    def amount(text, label, year_position=0):
        return extract_financial_value(
            text,
            label,
            reporting_unit="thousands",
            year_position=year_position,
        )

    if year in (2012, 2013):
        labels = {
            "total_equity": "Total equity",
            "shareholders_equity":
                "Total equity attributable to equity holders of the Bank",
            "profit_attributable": "Equity holders of the Bank",
            "operating_income": "Total operating income",
            "operating_expenses": "Total operating expenses",
        }
    else:
        labels = {
            "total_equity": "Total shareholders’ equity",
            "shareholders_equity":
                "Total shareholders’ equity attributable to equity holders of the Parent",
            "profit_attributable": "Equity holders of the Parent",
            "operating_income": "Operating income",
            "operating_expenses": "Operating expenses",
        }

    record.update({
        "Bank_Name": "National Commercial Bank (NCB)",
        "Country": "Saudi Arabia",
        "Year": year,

        "Total_Assets_LCU_Millions":
            amount(balance, "Total assets"),

        "Total_Liabilities_LCU_Millions":
            amount(balance, "Total liabilities"),

        "Total_Equity_LCU_Millions":
            amount(balance, labels["total_equity"]),

        "Shareholders_Equity_LCU_Millions":
            amount(
                balance,
                labels["shareholders_equity"],
            ),

        "Net_Profit_LCU_Millions":
            amount(income, "Net income for the year"),

        "Total_Operating_Income_LCU_Millions":
            amount(income, labels["operating_income"]),

        "Operating_Expenses_LCU_Millions":
            amount(income, labels["operating_expenses"]),

        "Net_Interest_Income_LCU_Millions":
            amount(income, "Net special commission income"),

        "Loans_Advances_Islamic_Financing_LCU_Millions":
            amount(balance, "Loans and advances, net"),

        "Customer_Accounts_Other_Deposits_LCU_Millions":
            amount(balance, "Customers’ deposits"),

        "Previous_Year_Total_Assets_LCU_Millions":
            amount(balance, "Total assets", 1),

        "Previous_Year_Total_Equity_LCU_Millions":
            amount(balance, "Total shareholders’ equity", 1),

        "Previous_Year_Shareholders_Equity_LCU_Millions":
            amount(
                balance,
                labels["shareholders_equity"],
                1,
            ),

        "Profit_Attributable_To_Shareholders_LCU_Millions":
            amount(
                income,
                labels["profit_attributable"],
            ),

        "Reporting_Currency": "SAR",
        "Reporting_Unit":
            "SAR millions; original report SR thousands",

        "Source_Document": config["pdf"].name,
        "Source_PDF_Page": (
            f'{config["balance_page"]}-{config["income_page"]},'
            f'{config["loans_page"]}-{config["impairment_page"]},'
            f'{config["npl_confirmation_page"]},'
            f'{config["capital_page"]}'
        ),
        "Source_Printed_Pages": config["printed_pages"],

        "Opening_Balance_Source": config["pdf"].name,
        "Opening_Balance_Source_PDF_Page": config["balance_page"],

        "Entity_Basis_Note":
            "NCB consolidated group, pre-2021 merger. "
            "Net special commission income mapped to net interest income. ""Net impairment charge represents credit losses only. "
            "Historical NCB and post-merger SNB figures require "
            "comparability assessment.",
    })

    assets = record["Total_Assets_LCU_Millions"]
    liabilities = record["Total_Liabilities_LCU_Millions"]
    equity = record["Total_Equity_LCU_Millions"]

    if abs(assets - liabilities - equity) > 0.001:
        raise ValueError(
            f"SNB {year} balance sheet reconciliation failed"
        )

    return record





def extract_published_car(text):
    """Extract current-year published CAR from the capital table."""
    import re

    label = "Core and supplementary capital (Tier 1 and Tier 2)"
    matches = []

    for line in text.splitlines():
        line = line.strip()

        if not line.startswith(label):
            continue

        values = line[len(label):].strip().split()

        if len(values) != 4:
            raise ValueError(
                f"Unexpected published CAR table layout: {values}"
            )

        if not all(
            re.fullmatch(r"[0-9,]+", value)
            for value in values[:2]
        ):
            raise ValueError("Invalid regulatory capital amounts.")

        ratios = [value.rstrip("%") for value in values[2:]]

        if not all(
            re.fullmatch(r"[0-9]+(?:[.][0-9]+)?", value)
            for value in ratios
        ):
            raise ValueError("Invalid published CAR percentages.")

        matches.append(float(ratios[0]))

    if len(matches) != 1:
        raise ValueError(
            f"Expected one published CAR row; found {len(matches)}"
        )

    return matches[0]



def extract_snb_capital_2012_2013(year):
    """Extract verified 2012–2013 capital and RWA disclosures."""
    import re

    if year not in (2012, 2013):
        raise ValueError(f"Unsupported year: {year}")

    config = get_snb_config(year)

    with pdfplumber.open(config["pdf"]) as pdf:
        capital_text = read_pdf_page(pdf, config["capital_page"])
        rwa_text = read_pdf_page(pdf, config["rwa_page"])

    def monetary_value(text, label):
        matching = [
            line.strip()
            for line in text.splitlines()
            if line.strip().startswith(label)
        ]

        if len(matching) != 1:
            raise ValueError(
                f"{year}: Expected one row for {label}; "
                f"found {len(matching)}"
            )

        remainder = matching[0][len(label):].strip()

        numbers = re.findall(
            r"(?<![A-Za-z0-9])\d{1,3}(?:,\d{3})+(?!\d)",
            remainder,
        )

        if len(numbers) < 2:
            raise ValueError(
                f"{year}: Missing monetary columns for {label}"
            )

        return float(numbers[0].replace(",", "")) / 1000

    capital = {
        "Eligible_Tier_1_Capital_LCU_Millions":
            monetary_value(capital_text, "Core capital (Tier 1)"),

        "Tier_2_Capital_LCU_Millions":
            monetary_value(
                capital_text, "Supplementary capital (Tier 2)"
            ),

        "Total_Regulatory_Capital_LCU_Millions":
            monetary_value(
                capital_text,
                "Core and supplementary capital (Tier 1 and Tier 2)",
            ),

        "Credit_Risk_RWA_LCU_Millions":
            monetary_value(rwa_text, "Credit risk"),

        "Operational_Risk_RWA_LCU_Millions":
            monetary_value(rwa_text, "Operational risk"),

        "Market_Risk_RWA_LCU_Millions":
            monetary_value(rwa_text, "Market risk"),
    }

    rwa_rows = [
        line.strip()
        for line in rwa_text.splitlines()
        if line.strip().startswith("Total Pillar")
        and "risk weighted assets" in line.lower()
    ]

    if len(rwa_rows) != 1:
        raise ValueError(
            f"{year}: Expected one total RWA row; "
            f"found {len(rwa_rows)}"
        )

    rwa_numbers = re.findall(
        r"\d{1,3}(?:,\d{3})+",
        rwa_rows[0],
    )

    if len(rwa_numbers) != 2:
        raise ValueError(
            f"{year}: Unexpected RWA monetary columns"
        )

    capital["RWA_LCU_Millions"] = (
        float(rwa_numbers[0].replace(",", "")) / 1000
    )

    car_rows = [
        line.strip()
        for line in capital_text.splitlines()
        if line.strip().startswith(
            "Core and supplementary capital (Tier 1 and Tier 2)"
        )
    ]

    if len(car_rows) != 1:
        raise ValueError(f"{year}: CAR row not unique")

    car_values = re.findall(
        r"\d+(?:\.\d+)?%",
        car_rows[0],
    )

    if not car_values:
        car_values = re.findall(
            r"\b\d+\.\d+\b",
            car_rows[0],
        )

    if len(car_values) < 2:
        raise ValueError(
            f"{year}: Expected current and comparative CAR"
        )

    capital["Published_CAR_Pct"] = float(
        car_values[0].rstrip("%")
    )

    tier_total = (
        capital["Eligible_Tier_1_Capital_LCU_Millions"]
        + capital["Tier_2_Capital_LCU_Millions"]
    )

    rwa_total = (
        capital["Credit_Risk_RWA_LCU_Millions"]
        + capital["Operational_Risk_RWA_LCU_Millions"]
        + capital["Market_Risk_RWA_LCU_Millions"]
    )

    if abs(
        tier_total
        - capital["Total_Regulatory_Capital_LCU_Millions"]
    ) > 0.001:
        raise ValueError(
            f"{year}: Capital reconciliation failed"
        )

    if abs(
        rwa_total - capital["RWA_LCU_Millions"]
    ) > 0.001:
        raise ValueError(
            f"{year}: RWA reconciliation failed"
        )

    capital["CAR_Pct"] = (
        capital["Total_Regulatory_Capital_LCU_Millions"]
        / capital["RWA_LCU_Millions"]
        * 100
    )

    capital["CAR_Source_PDF_Page"] = config["capital_page"]

    return capital

def extract_snb_2010_capital(year=2010):
    if year in (2012, 2013):
        return extract_snb_capital_2012_2013(year)
    """Extract and reconcile SNB regulatory capital by year."""
    import re

    config = get_snb_config(year)

    with pdfplumber.open(config["pdf"]) as pdf:
        capital_text = read_pdf_page(pdf, config["capital_page"])
        rwa_text = read_pdf_page(
            pdf,
            config.get("rwa_page", config["capital_page"]),
        )

    def amount(text, label):
        return extract_financial_value(
            text,
            label,
            reporting_unit="thousands",
        )

    capital = {
        "Eligible_Tier_1_Capital_LCU_Millions":
            amount(capital_text, "Core capital (Tier 1)"),

        "Tier_2_Capital_LCU_Millions":
            amount(capital_text, "Supplementary capital (Tier 2)"),

        "Total_Regulatory_Capital_LCU_Millions":
            amount(
                capital_text,
                "Core and supplementary capital (Tier 1 and Tier 2)",
            ),

        "Credit_Risk_RWA_LCU_Millions":
            amount(rwa_text, "Credit risk"),

        "Operational_Risk_RWA_LCU_Millions":
            amount(rwa_text, "Operational risk"),

        "Market_Risk_RWA_LCU_Millions":
            amount(rwa_text, "Market risk"),
    }

    total_rwa_lines = [
        line for line in rwa_text.splitlines()
        if re.search(
            r"Total Pillar.{0,5}1.*risk weighted assets",
            line,
            flags=re.IGNORECASE,
        )
    ]

    if len(total_rwa_lines) != 1:
        raise ValueError(
            f"Expected one total RWA line for {year}; "
            f"found {len(total_rwa_lines)}"
        )

    rwa_line = total_rwa_lines[0]

    numbers = re.findall(r"[0-9][0-9,]*", rwa_line)

    if len(numbers) < 3:
        raise ValueError(
            f"Unable to parse total RWA for {year}: {rwa_line}"
        )

    capital["RWA_LCU_Millions"] = (
        float(numbers[-2].replace(",", "")) / 1000
    )

    tier_total = (
        capital["Eligible_Tier_1_Capital_LCU_Millions"]
        + capital["Tier_2_Capital_LCU_Millions"]
    )

    rwa_total = (
        capital["Credit_Risk_RWA_LCU_Millions"]
        + capital["Operational_Risk_RWA_LCU_Millions"]
        + capital["Market_Risk_RWA_LCU_Millions"]
    )

    if abs(
        tier_total
        - capital["Total_Regulatory_Capital_LCU_Millions"]
    ) > 0.001:
        raise ValueError("Regulatory capital reconciliation failed.")

    if abs(
        rwa_total
        - capital["RWA_LCU_Millions"]
    ) > 0.001:
        raise ValueError("RWA reconciliation failed.")

    capital["CAR_Pct"] = (
        capital["Total_Regulatory_Capital_LCU_Millions"]
        / capital["RWA_LCU_Millions"]
        * 100
    )

    capital["Published_CAR_Pct"] = extract_published_car(
        capital_text
    )
    capital["CAR_Source_PDF_Page"] = config["capital_page"]

    return capital




def extract_snb_loans_2012_2013(year):
    """Extract current-year loan disclosures for 2012 and 2013."""
    import re

    if year not in (2012, 2013):
        raise ValueError(f"Unsupported loan reporting year: {year}")

    config = get_snb_config(year)

    with pdfplumber.open(config["pdf"]) as pdf:
        loans_text = read_pdf_page(pdf, config["loans_page"])
        impairment_text = read_pdf_page(
            pdf, config["impairment_page"]
        )

    def tokens(line):
        return re.findall(
            r"\(?\d{1,3}(?:,\d{3})+\)?",
            line,
        )

    def money(token):
        return float(
            token.replace(",", "")
            .replace("(", "")
            .replace(")", "")
        ) / 1000

    lines = loans_text.splitlines()

    def year_header(line, target_year):
        return (
            re.match(
                rf"^\s*{target_year}\s+(?:SR|SAR)\b",
                line,
            ) is not None
            or line.strip() == str(target_year)
        )

    starts = [
        i for i, line in enumerate(lines)
        if year_header(line, year)
    ]

    if len(starts) != 1:
        raise ValueError(
            f"{year}: Expected one current-year loan header; "
            f"found {len(starts)}"
        )

    start = starts[0]

    ends = [
        i for i in range(start + 1, len(lines))
        if year_header(lines[i], year - 1)
    ]

    if len(ends) != 1:
        raise ValueError(
            f"{year}: Expected one comparative-year header; "
            f"found {len(ends)}"
        )

    section = lines[start:ends[0]]

    def total(predicate, field):
        matches = [
            line.strip()
            for line in section
            if predicate(line.strip())
        ]

        if len(matches) != 1:
            raise ValueError(
                f"{year} {field}: Expected one row; "
                f"found {len(matches)}"
            )

        values = tokens(matches[0])

        if len(values) != 5:
            raise ValueError(
                f"{year} {field}: Expected five monetary columns"
            )

        return money(values[-1])

    gross = total(
        lambda line: line.startswith(
            "Total loans and advances"
        ),
        "gross loans",
    )

    npl = total(
        lambda line: (
            line.startswith("Non")
            and "performing loans and advances" in line
        ),
        "non-performing loans",
    )

    provision = total(
        lambda line: line.startswith(
            "Provision for credit losses"
        ),
        "credit-loss provision",
    )

    net = total(
        lambda line: (
            line.startswith("Loans & advances, net")
            or line.startswith("Loans and advances, net")
        ),
        "net loans",
    )

    impairment_lines = impairment_text.splitlines()

    if year == 2012:
        matches = [
            line.strip()
            for line in impairment_lines
            if line.strip().startswith(
                "Net charge for the year"
            )
            and "credit losses" in line.lower()
        ]
    else:
        matches = [
            " ".join(impairment_lines[i:i + 2]).strip()
            for i, line in enumerate(impairment_lines)
            if "Net charge for the year (impairment" in line
        ]

    if len(matches) != 1:
        raise ValueError(
            f"{year}: Expected one impairment row; "
            f"found {len(matches)}"
        )

    impairment_values = tokens(matches[0])

    if len(impairment_values) != 2:
        raise ValueError(
            f"{year}: Expected two impairment monetary columns"
        )

    impairment = money(impairment_values[0])

    if gross <= 0:
        raise ValueError(f"{year}: Gross loans must be positive")

    if abs(gross - provision - net) > 0.001:
        raise ValueError(
            f"{year}: Loan reconciliation failed"
        )

    return {
        "Gross_Loans_LCU_Millions": gross,
        "Non_Performing_Loans_LCU_Millions": npl,
        "Net_Impairment_Charge_LCU_Millions": impairment,
        "Loans_Advances_Islamic_Financing_LCU_Millions": net,
        "NPL_Ratio_Pct": npl / gross * 100,
        "Gross_Loans_Source_PDF_Page": config["loans_page"],
        "NPL_Source_PDF_Page": (
            f'{config["loans_page"]},'
            f'{config["npl_confirmation_page"]}'
        ),
    }

def extract_snb_2010_loans(year=2010):
    if year in (2012, 2013):
        return extract_snb_loans_2012_2013(year)
    """Extract and reconcile SNB loan disclosures by year."""
    config = get_snb_config(year)
    from pipeline.financial_parser import extract_table_total

    with pdfplumber.open(config["pdf"]) as pdf:
        loans_text = read_pdf_page(pdf, config["loans_page"])
        impairment_text = read_pdf_page(pdf, config["impairment_page"])

    gross = extract_table_total(
        loans_text, "Total loans and advances"
    )
    npl = extract_table_total(
        loans_text, "Non-performing loans and advances"
    )
    provision = extract_table_total(
        loans_text, "Provision for credit losses"
    )
    net = extract_table_total(
        loans_text, "Loans & advances, net"
    )
    impairment = extract_financial_value(
        impairment_text,
        "Net charge for the year (impairment charge for credit losses, net)",
        reporting_unit="thousands",
    )

    if abs(gross + provision - net) > 0.001:
        raise ValueError("Loan reconciliation failed.")

    if gross <= 0:
        raise ValueError("Gross loans must be positive.")

    return {
        "Gross_Loans_LCU_Millions": gross,
        "Non_Performing_Loans_LCU_Millions": npl,
        "Net_Impairment_Charge_LCU_Millions": impairment,
        "Loans_Advances_Islamic_Financing_LCU_Millions": net,
        "NPL_Ratio_Pct": npl / gross * 100,
        "Gross_Loans_Source_PDF_Page": config["loans_page"],
        "NPL_Source_PDF_Page": (
            f'{config["loans_page"]},'
            f'{config["npl_confirmation_page"]}'
        ),
    }


def calculate_snb_2010_metrics(record):
    """Calculate SNB 2010 financial ratios from extracted figures."""

    def number(field):
        value = record.get(field)
        if value is None or str(value).strip() == "":
            raise ValueError(f"Missing input for ratio: {field}")
        return float(value)

    assets = number("Total_Assets_LCU_Millions")
    previous_assets = number(
        "Previous_Year_Total_Assets_LCU_Millions"
    )

    equity = number("Total_Equity_LCU_Millions")
    previous_equity = number(
        "Previous_Year_Total_Equity_LCU_Millions"
    )

    shareholders_equity = number(
        "Shareholders_Equity_LCU_Millions"
    )
    previous_shareholders_equity = number(
        "Previous_Year_Shareholders_Equity_LCU_Millions"
    )

    average_assets = (assets + previous_assets) / 2
    average_equity = (equity + previous_equity) / 2
    average_shareholders_equity = (
        shareholders_equity + previous_shareholders_equity
    ) / 2

    operating_income = number(
        "Total_Operating_Income_LCU_Millions"
    )
    operating_expenses = number(
        "Operating_Expenses_LCU_Millions"
    )

    if min(
        average_assets,
        average_equity,
        average_shareholders_equity,
        operating_income,
    ) <= 0:
        raise ValueError("Invalid denominator in financial ratios.")

    return {
        "Average_Total_Assets_LCU_Millions": average_assets,
        "Average_Total_Equity_LCU_Millions": average_equity,
        "Average_Shareholders_Equity_LCU_Millions":
            average_shareholders_equity,

        "CIR_Pct":
            operating_expenses / operating_income * 100,

        "ROA_Pct":
            number("Net_Profit_LCU_Millions")
            / average_assets * 100,

        "ROE_Pct":
            number("Profit_Attributable_To_Shareholders_LCU_Millions")
            / average_shareholders_equity * 100,

        "ROA_Method":
            "Consolidated net profit / average total assets * 100",

        "ROE_Method":
            "Profit attributable to parent / average parent "
            "shareholders' equity * 100",
    }

def compare_existing(record):
    with SCHEMA_PATH.open(
        encoding="utf-8-sig",
        newline="",
    ) as f:
        rows = list(csv.DictReader(f))

    year = str(record["Year"]).strip()

    matches = [
        row for row in rows
        if str(row.get("Year", "")).strip() == year
    ]

    if len(matches) != 1:
        raise ValueError(
            f"Expected one existing SNB {year} record; "
            f"found {len(matches)}"
        )

    existing = matches[0]

    compared = 0
    matched = 0
    differences = []

    for column, new_value in record.items():
        if new_value == "":
            continue

        old_value = existing.get(column, "")

        if old_value == "":
            continue

        compared += 1

        try:
            same = (
                abs(float(new_value) - float(old_value))
                < 0.001
            )
        except (ValueError, TypeError):
            same = str(new_value) == str(old_value)

        if same:
            matched += 1
        else:
            differences.append(
                (column, old_value, new_value)
            )

    print("\nCOMPARISON AGAINST EXISTING DATASET")
    print("=" * 65)
    print("Fields compared:", compared)
    print("Matching fields:", matched)
    print("Differences:", len(differences))

    for column, old, new in differences:
        print(f"\nDIFFERENCE: {column}")
        print("Existing:", old)
        print("Extracted:", new)

    return differences


def main():
    print("UNIFIED EXTRACTION ENGINE — SNB 2010")
    print("=" * 65)

    record = extract_snb_2010()

    print("Schema columns:", len(record))
    print("Balance sheet reconciliation: PASS")

    capital = extract_snb_2010_capital()
    record.update(capital)

    print("Regulatory capital reconciliation: PASS")
    print("RWA reconciliation: PASS")

    loans = extract_snb_2010_loans()
    record.update(loans)

    print("Loan reconciliation: PASS")

    metrics = calculate_snb_2010_metrics(record)
    record.update(metrics)

    print("Financial ratios calculated: PASS")

    populated = sum(
        value is not None and str(value).strip() != ""
        for value in record.values()
    )

    print("Populated fields:", populated)
    print("Unpopulated fields:", len(record) - populated)

    compare_existing(record)

    print("\nExisting financial datasets: UNCHANGED")


if __name__ == "__main__":
    main()
